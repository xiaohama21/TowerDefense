[sub_resource type="Resource" id="DialogueLine_1"]
script = ExtResource("9_dline")
speaker = "张梁"
text = "苍天已死，黄天当立！尔等汉家走狗，安敢犯我天兵！"

[sub_resource type="Resource" id="DialogueLine_2"]
script = ExtResource("9_dline")
speaker = "关羽"
text = "口出狂言。今日便教你知道，谁才是天数。"

[sub_resource type="Resource" id="DialogueLine_3"]
script = ExtResource("9_dline")
speaker = "刘备"
text = "众将听令——破广宗，平黄巾，在此一举！"

[sub_resource type="Resource" id="DialogueLine_4"]
script = ExtResource("9_dline")
speaker = "张角"
text = "布阵、唤雨、狂雷——天书三卷在此，尔等可敢一试？"

[sub_resource type="Resource" id="DialogueLine_5"]
script = ExtResource("9_dline")
speaker = "诸葛亮"
text = "贼将张梁擅召援兵，岔路来敌，不可不防；张角三卷轮转，切莫孤注一掷。"

