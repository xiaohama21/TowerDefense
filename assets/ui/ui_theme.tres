[gd_resource type="Theme" load_steps=4 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/ZCOOL-Kuaile.ttf" id="1_font"]

[sub_resource type="SystemFont" id="SystemFont_fallback"]
